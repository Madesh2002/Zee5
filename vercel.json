{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/playlist.m3u",
      "destination": "/api/index"
    },
    {
      "source": "/assistant-chat",
      "destination": "/api/index"
    },
    {
      "source": "/live/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
